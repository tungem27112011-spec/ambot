-- 2. HỆ THỐNG XỬ LÝ LỌC VÀ HIỂN THỊ ESP TỐI ƯU FPS
-- ====================================================================
local function getPlayerColor(player)
    return (player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team) and teamColor or enemyColor
end

local function cleanESP(char)
    if not char then return end
    local highlight = char:FindFirstChild(espName)
    if highlight then highlight:Destroy() end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local tracer = root:FindFirstChild(tracerName)
        if tracer then tracer:Destroy() end
        local attach = root:FindFirstChild("EnemyTracerAttachment")
        if attach then attach:Destroy() end
    end
end

local function refreshPlayerESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    if not root or not humanoid or humanoid.Health <= 0 then 
        cleanESP(char)
        return 
    end

    local color = getPlayerColor(player)

    -- 1. Xử lý Box ESP tối ưu (Giảm độ dày đường viền tránh lag mắt)
    local highlight = char:FindFirstChild(espName)
    if espBoxEnabled then
        if not highlight then
            highlight = Instance_new("Highlight")
            highlight.Name = espName
            highlight.Parent = char
        end
        highlight.FillColor = color
        highlight.FillTransparency = 0.65
        highlight.OutlineColor = Color3_fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0.3
    else
        if highlight then highlight:Destroy() end
    end

    -- 2. Xử lý Dây nối Tracers (Chỉ render khi thực sự di chuyển)
    local localChar = LocalPlayer.Character
    local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
    
    if espTracerEnabled and localRoot then
        local localAttach = localRoot:FindFirstChild("MyTracerAttachment")
        if not localAttach then
            localAttach = Instance_new("Attachment")
            localAttach.Name = "MyTracerAttachment"
            localAttach.Position = Vector3_new(0, -3, 0)
            localAttach.Parent = localRoot
        end

        local targetAttach = root:FindFirstChild("EnemyTracerAttachment")
        if not targetAttach then
            targetAttach = Instance_new("Attachment")
            targetAttach.Name = "EnemyTracerAttachment"
            targetAttach.Position = Vector3_new(0, -3, 0)
            targetAttach.Parent = root
        end

        local beam = root:FindFirstChild(tracerName)
        if not beam then
            beam = Instance_new("Beam")
            beam.Name = tracerName
            beam.Width0 = 0.03
            beam.Width1 = 0.03
            beam.FaceCamera = true
            beam.Parent = root
        end
        beam.Attachment0 = localAttach
        beam.Attachment1 = targetAttach
        beam.Color = ColorSequence_new(color)
    else
        local beam = root:FindFirstChild(tracerName)
        if beam then beam:Destroy() end
    end
end

