-- 2. HỆ THỐNG QUÉT VÀ HIỂN THỊ ESP ĐỒNG BỘ THEO ĐỘI
-- ====================================================================
local function getLocalAttachment()
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local attach = root:FindFirstChild("MyTracerAttachment")
    if not attach then
        attach = Instance.new("Attachment")
        attach.Name = "MyTracerAttachment"
        attach.Position = Vector3.new(0, -2, 0)
        attach.Parent = root
    end
    return attach
end

local function getPlayerColor(player)
    if player.Team and LocalPlayer.Team then
        if player.Team == LocalPlayer.Team then return teamColor end
    end
    return enemyColor
end

local function refreshPlayerESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    -- Tự dọn dẹp dữ liệu cũ khi đối thủ chết hẳn
    if humanoid and humanoid.Health <= 0 then
        local oldHl = char:FindFirstChild(espName)
        local oldBeam = char:FindFirstChild(tracerName)
        if oldHl then oldHl:Destroy() end
        if oldBeam then oldBeam:Destroy() end
        return
    end

    if not root then return end
    local targetColor = getPlayerColor(player)

    -- Xử lý nút bật/tắt Khung nhìn xuyên tường độc lập
    local hl = char:FindFirstChild(espName)
    if espBoxEnabled then
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = espName
            hl.FillTransparency = 0.5
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
        end
        hl.FillColor = targetColor
        hl.OutlineColor = targetColor
        hl.Enabled = true
    else
        if hl then hl.Enabled = false end
    end

    -- Xử lý nút bật/tắt Dây nối độc lập
    local beam = char:FindFirstChild(tracerName)
    if espTracerEnabled then
        local targetAttach = root:FindFirstChild("TracerTargetAttachment")
        if not targetAttach then
            targetAttach = Instance.new("Attachment")
            targetAttach.Name = "TracerTargetAttachment"
            targetAttach.Position = Vector3.new(0, -2, 0)
            targetAttach.Parent = root
        end

        if not beam then
            beam = Instance.new("Beam")
            beam.Name = tracerName
            beam.Width0 = 0.04
            beam.Width1 = 0.04
            beam.FaceCamera = true
            beam.Attachment1 = targetAttach
            beam.Parent = char
        end
        beam.Color = ColorSequence.new(targetColor)

        local myAttach = getLocalAttachment()
        if myAttach then
            beam.Attachment0 = myAttach
            beam.Enabled = true
        else
            beam.Enabled = false
        end
    else
        if beam then beam.Enabled = false end
    end
end

-- Quét liên tục dữ liệu ESP chống mất dấu khi hồi sinh
task.spawn(function()
    while true do
        for _, p in pairs(Players:GetPlayers()) do
            pcall(function() refreshPlayerESP(p) end)
        end
        task.wait(0.4)
    end
end)

