-- 0. HỆ THỐNG ANTI-BAN CHẠY NGẦM BẢO VỆ TÀI KHOẢN
-- ====================================================================
local function initAntiBan()
    local metatable = getrawmetatable(game)
    if not metatable then return end
    
    setreadonly(metatable, false)
    local oldNamecall = metatable.__namecall
    local oldIndex = metatable.__index

    metatable.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "ReportAbuse" or method == "SubmitScreenshot" then return nil end
        if tostring(self) == "CrashReporter" or tostring(self) == "AnalyticsService" then return nil end
        return oldNamecall(self, ...)
    end)

    metatable.__index = newcclosure(function(self, key)
        if not checkcaller() then
            if key == "Name" and (self.Name == "ESP_Menu_Gui_Fixed" or self.Name == espName or self.Name == tracerName) then
                return "Instance"
            end
        end
        return oldIndex(self, key)
    end)
    
    setreadonly(metatable, true)
end

pcall(initAntiBan)

