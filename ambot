-- 3. VÒNG LẶP ĐỒNG BỘ THEO NHỊP ĐỘ GAME (HEARTBEAT - HIGH PERFORMANCE)
-- ====================================================================
local playerList = Players:GetPlayers()

-- Cập nhật danh sách người chơi sau mỗi 1 giây thay vì cập nhật liên tục mỗi frame
task.spawn(function()
    while task.wait(1) do
        playerList = Players:GetPlayers()
    end
end)

RunService.Heartbeat:Connect(function()
    for i = 1, #playerList do
        local player = playerList[i]
        if player then
            pcall(refreshPlayerESP, player)
        end
    end
end)

-- Dọn sạch khi có người chơi rời trận hoặc hồi sinh đổi nhân vật
Players.PlayerRemoving:Connect(function(player)
    if player.Character then cleanESP(player.Character) end
end)
