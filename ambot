-- Sử dụng nội suy CFrame để khóa tâm cực kỳ mượt mà, không bao giờ bị đơ đứng hình
RunService.RenderStepped:Connect(function()
    if aimbotEnabled and isAiming then
        local target = getClosestEnemy()
        if target and target.Character then
            local aimTarget = getTargetPart(target.Character)
            if aimTarget then
                -- Hệ số mượt mà (0.25), tăng số này lên nếu bạn muốn khóa nhanh hơn
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, aimTarget.Position), 0.25)
            end
        end
    end
end)

